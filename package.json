{
  "name": "vdc-bot",
  "version": "1.0.0",
  "description": "Valorant Draft Circuit's Discord Bot",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "deploy": "pnpm run cache && pnpm run start",

    "compile": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke.js",
    "cache": "node ./cache/cache.js",
    "dev:start": "nodemon --no-warnings --ignore ./cache/ --ignore ./bin/ bot.js",
    "dev:compile": "pnpm run cache && tsc -w -p tsconfig.json",
    "dev:run": "pnpm install && pnpm run compile && pnpm run cache && pnpm run dev:start",
    "generate": "prisma generate && (clear || cls)",
    "pull": "prisma db pull --force",
    "studio": "prisma studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Valorant-Draft-Circuit/vdc-bot"
  },
  "contributors": ["Rohan Gupta", "Unieveth", "Treeko", "Kryo", "dlatngh"],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Valorant-Draft-Circuit/vdc-bot/issues"
  },
  "homepage": "https://github.com/Valorant-Draft-Circuit/vdc-bot#readme",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.52",
    "@prisma/client": "^6.15.0",
    "chalk": "^4.1.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.0.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "nodemon": "^2.0.20",
    "prisma": "^6.15.0",
    "typescript": "^5.2.2"
  }
}
