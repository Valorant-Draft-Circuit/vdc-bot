# TOKENS ------------------------------------------------------------------------------------------
TOKEN           = "TOKEN"
###################################################################################################


# MISC --------------------------------------------------------------------------------------------
# connects the Discord drain channels: the logdrain, #submitted-games (matchdrain) and member logs
LOGDRAIN_ENABLE = "false"
# which log lines the Discord logdrain also gets: this level and above, in the order VERBOSE, DEBUG, INFO,
# WARNING, ERROR, ALERT (ALERT pings the alerts role). Unset = none. Grafana always gets every line, and
# Discord never gets stacks: ERRORs and lines with a stack link to their trace (or logs) in Grafana instead.
# LOGDRAIN_LEVEL  = "ERROR"
VDC_WEB_URL     = ""
FORCE_COLOR=1
###################################################################################################

# FEATURES ENABLE ---------------------------------------------------------------------------------
COMBINES_SORT   = "false"
QUEUE_SYSTEM_ENABLED = "true"
# development bot only: DMs to users are blocked unless this is "true" (ignored when PROD=1)
DEV_DMS_ENABLED = "false"
###################################################################################################


# SERVER IDS & CHANNEL INFO -----------------------------------------------------------------------
# DEVELOPMENT SERVER
SERVER_ID       = "1027754353207033966"

DEV_SERVER      = "1027754353207033966"
LOGGING_CHANNEL = "1328952835932684400"
###################################################################################################


# API & DATABASE KEYS -----------------------------------------------------------------------------
VDC_API_KEY     = "riot_api_key"
DATABASE_URL    = "mysql://username:password@url/db_name"
REDIS_URL       = "redis://default:@url"

# Numbers service (match detection + submission). Base URL defaults to production if unset.
NUMBERS_BASE_URL      = "https://numbers.vdc.gg"
###################################################################################################


# TELEMETRY (vdc-observability) -------------------------------------------------------------------
# Off unless OTEL_EXPORTER_OTLP_ENDPOINT is set. Locally, run vdc-observability's scripts/dev.sh up and
# use the endpoint below (no auth). Prod uses https://otel.vdc.gg with the bot's ingest login.
# OTEL_EXPORTER_OTLP_ENDPOINT = "http://localhost:4318"
# OTEL_EXPORTER_OTLP_HEADERS  = "Authorization=Basic%20..."
# deployment.environment.name defaults to prod/dev from PROD; service.name defaults to vdc-bot
# OTEL_RESOURCE_ATTRIBUTES    = "deployment.environment.name=dev"
# Grafana base URL, for the trace / logs links on Discord logdrain lines
# GRAFANA_URL                 = "http://localhost:3000"
###################################################################################################
